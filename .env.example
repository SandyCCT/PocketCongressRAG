# AI provider（chat 與 embedding 可分別選擇 openai 或 vertexai）
CHAT_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# OpenAI 設定
OPENAI_API_KEY=your_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# GCP Vertex AI 設定（provider 設為 vertexai 時使用 ADC 驗證）
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=global
VERTEX_CHAT_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
# OpenAI／Vertex AI Chat 與 Embedding 的單次請求 timeout（秒）
AI_REQUEST_TIMEOUT_SECONDS=60
# 額外重試次數：2 表示首次＋最多 2 次重試，0 表示不重試
# Vertex 索引建置腳本使用獨立的 batch 重試
AI_MAX_RETRIES=2
# Docker Compose 使用 Vertex AI 時，取消註解並填入本機 ADC 絕對路徑
# GOOGLE_ADC_PATH=/absolute/path/to/application_default_credentials.json

# 路徑與表名（index 路徑會依 EMBEDDING_PROVIDER 自動選擇）
DATA_FOLDER_PATH=../data/sessions
# INSTANCE_DIR=../instance/custom
# ROW_COUNT_HISTORY_PATH=../instance/custom/row_count_tracker.json
# CHROMA_DIR=../instance/custom/chroma_db
# DB_PATH=../instance/custom/legislature.db

# 本機 Docker Compose 對外連接埠
POCKETCONGRESS_PORT=18000

# 本機初始化或建立新會期 index 時使用；可能產生 Embedding API 費用
INDEX_REBUILD_POLICY=auto

# 應用程式日誌（Cloud image 已設定 LOG_FILE_ENABLED=false）
TZ=Asia/Taipei
LOG_DIR=../logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
LOG_FILE_ENABLED=true

# Cloud Run 會自動注入 PORT，Dockerfile 會設定 metadata 與 manifest 路徑
# PORT=8000
# RUNTIME_METADATA_PATH=/app/deployment/runtime_metadata.json
# DEPLOYMENT_MANIFEST_PATH=/app/deployment/manifest.json
